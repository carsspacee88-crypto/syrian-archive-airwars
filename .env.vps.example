ARCHIVE_DOMAIN=archive-admin.example.org
ARCHIVE_DATABASE_NAME=archive_admin
ARCHIVE_DATABASE_USER=archive
ARCHIVE_ADMIN_USERNAME=admin
ARCHIVE_SECURE_COOKIES=true

# قيم محافظة كبداية. تُضبط بعد قياس VPS على عينة صغيرة.
ARCHIVE_COLLECTOR_WORKERS=6
ARCHIVE_COLLECTOR_PER_HOST_WORKERS=1
ARCHIVE_COLLECTOR_DELAY=0.75
ARCHIVE_COLLECTOR_TIMEOUT=10
ARCHIVE_COLLECTOR_RETRIES=1
ARCHIVE_INCIDENT_CHUNK_SIZE=10
ARCHIVE_SOURCE_CHUNK_SIZE=100
